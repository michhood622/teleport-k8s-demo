# 30. Create `nginx-rbac.yaml`

Create:

```bash
cat <<'EOF' > manifests/nginx-rbac.yaml
apiVersion: rbac.authorization.k8s.io/v1
kind: Role
metadata:
  name: nginx-developer
  namespace: nginx-demo
rules:

  - apiGroups:
      - ""
    resources:
      - pods
      - pods/log
      - services
      - endpoints
      - configmaps
      - secrets
    verbs:
      - get
      - list
      - watch
      - create
      - update
      - patch
      - delete

  - apiGroups:
      - apps
    resources:
      - deployments
      - replicasets
    verbs:
      - get
      - list
      - watch
      - create
      - update
      - patch
      - delete

  - apiGroups:
      - networking.k8s.io
    resources:
      - ingresses
    verbs:
      - get
      - list
      - watch
      - create
      - update
      - patch
      - delete

  - apiGroups:
      - cert-manager.io
    resources:
      - certificates
    verbs:
      - get
      - list
      - watch
      - create
      - update
      - patch
      - delete

---
apiVersion: rbac.authorization.k8s.io/v1
kind: RoleBinding
metadata:
  name: nginx-developer-binding
  namespace: nginx-demo

subjects:
  - kind: User
    name: nginx-user
    apiGroup: rbac.authorization.k8s.io

roleRef:
  kind: Role
  name: nginx-developer
  apiGroup: rbac.authorization.k8s.io
EOF
```

Inspect:

```bash
cat manifests/nginx-rbac.yaml
```

Apply:

```bash
kubectl apply \
  -f manifests/nginx-rbac.yaml
```

